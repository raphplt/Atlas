# Copiez ce fichier en .env.local. Ne commitez jamais de vraies clés.

# --- E-mail (formulaire de contact, via Resend) ---
RESEND_API_KEY=
# Ex. : "Atlas <site@raphael-plassart.com>" (domaine vérifié dans Resend)
MAIL_FROM=
# Destinataire des messages (défaut : contact@raphael-plassart.com)
MAIL_TO=contact@raphael-plassart.com
# Intégration CRM optionnelle.
MAKE_WEBHOOK_URL=

# --- Sanity (blog, études de cas, témoignages) ---
# Sans ces variables, le site fonctionne avec les articles statiques de content/journal.ts.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-09-01
# Uniquement si le dataset est privé (jeton « Viewer »).
SANITY_API_READ_TOKEN=
# Uniquement pour `npm run sanity:seed` (jeton « Editor »). Ne pas définir en production.
SANITY_API_WRITE_TOKEN=
# Secret partagé avec le webhook Sanity → /api/revalidate
SANITY_REVALIDATE_SECRET=
